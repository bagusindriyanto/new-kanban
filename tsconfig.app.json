{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "module": "ESNext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    // "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting/Strictness */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    "paths": {
      "@/*": ["./src/*"]
    },

    /* JS interoperability for incremental migration */
    "allowJs": true,
    "checkJs": false,
    "strictNullChecks": true // tapi ini worth dinyalakan dari awal, bug null/undefined paling sering nangkep
  },
  "include": ["src"]
}
